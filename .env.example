# ==============================================================================
# WEFIT APPLICATION ENVIRONMENT VARIABLES (EXAMPLE)
# ==============================================================================

# --- DATABASE CONFIGURATIONS ---
# UserService (PostgreSQL)
DB_URL_USER_SERVICE=jdbc:postgresql://localhost:5432/wefit
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# ActivityService (MongoDB)
MONGODB_URI_ACTIVITY_SERVICE=mongodb://localhost:27017/WefitActivitydb
MONGODB_DATABASE_ACTIVITY_SERVICE=WefitActivitydb

# AiService (MongoDB)
MONGODB_URI_AI_SERVICE=mongodb://localhost:27017/AiRecommendationsdb
MONGODB_DATABASE_AI_SERVICE=AiRecommendationsdb

# --- MESSAGE BROKER (KAFKA) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NAME=activity-events
KAFKA_CONSUMER_GROUP_ID=activity-processor-group

# --- SERVICE DISCOVERY (EUREKA) ---
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka

# --- GEMINI AI CONFIGURATIONS ---
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_API_KEY=your_gemini_api_key_here

# --- API Gateway Security & CORS ---
KEYCLOAK_CERTS_URL=http://localhost:8090/realms/wefit/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT / Auth
